<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>AllowedTypes</key>
    <array>
        <string>public.swift-source</string>
    </array>
    <key>DefaultCompletionName</key>
    <string>File</string>
    <key>Description</key>
    <string>A Swift shared-default class (like URLSession.shared).
    CAUTION: You are now entering a piece of global state into your project.
    Keep it to ONE small job, otherwise proceed at your own risk! </string>
    <key>Kind</key>
    <string>Xcode.IDEFoundation.TextSubstitutionFileTemplateKind</string>
    <key>MainTemplateFile</key>
    <string>___FILEBASENAME___.swift</string>
    <key>Options</key>
    <array>
        <dict>
            <key>Description</key>
            <string>The name of the Singleton Class to create</string>
            <key>Identifier</key>
            <string>productName</string>
            <key>Name</key>
            <string>Class Name:</string>
            <key>NotPersisted</key>
            <true/>
            <key>Required</key>
            <true/>
            <key>Type</key>
            <string>text</string>
        </dict>
        <dict>
            <key>Default</key>
            <string>shared</string>
            <key>Description</key>
            <string>The name of the static shared instance</string>
            <key>Identifier</key>
            <string>SharedInstanceName</string>
            <key>Name</key>
            <string>Shared Instance Name:</string>
            <key>NotPersisted</key>
            <true/>
            <key>Required</key>
            <true/>
            <key>Type</key>
            <string>text</string>
        </dict>
    </array>
    <key>SortOrder</key>
    <string>1</string>
    <key>Summary</key>
    <string>Create a new shared-default class swift source file.</string>
</dict>
</plist>
